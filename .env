# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=5000

# Postgres connection (Render gives you this as one string, or use the parts below)
DATABASE_URL=postgres://user:password@host:5432/lifeos
# If DATABASE_URL isn't used, these are used instead:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lifeos
DB_USER=postgres
DB_PASSWORD=postgres

# Auth
# This is your login passcode, but stored as a bcrypt HASH, not plain text.
# Generate one with: node backend/scripts/hash-passcode.js yourPasscodeHere
PASSCODE_HASH=
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
